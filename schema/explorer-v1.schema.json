  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/Envelope"
    },
    {
      "$ref": "#/$defs/Manifest"
    }
  ],
  "title": "Nicos Catalog Explorer v1"
}
